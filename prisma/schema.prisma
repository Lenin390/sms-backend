generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Shop {
  id        String   @id @default(uuid())
  ownerId   String   @unique
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner     User     @relation("ShopOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  staff     User[]     @relation("ShopStaff")
  employees Employee[]
  orders    Order[]

  @@map("shops")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  shopId       String?
  ownedShop    Shop?    @relation("ShopOwner")
  shop         Shop?    @relation("ShopStaff", fields: [shopId], references: [id], onDelete: Cascade)
  employee Employee?
  refreshTokens RefreshToken[]

  @@map("users")
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

model Employee {
  id          String   @id @default(uuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  designation String?
  payType     PayType  @default(MONTHLY)
  payRate     Float
  joiningDate DateTime @default(now())
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Only set if employee also has a login (e.g. a manager). Most won't.
  linkedUserId String? @unique
  linkedUser   User?   @relation(fields: [linkedUserId], references: [id])

  attendance  Attendance[]
  payrollRuns PayrollRun[]
  assignments WorkAssignment[]

  @@map("employees")
}

enum PayType {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  PIECE_RATE
}

model Attendance {
  id          String           @id @default(uuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime         @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  piecesCompleted Int              @default(0)
  status      AttendanceStatus @default(PRESENT)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([employeeId, date]) // can't have two attendance entries for the same day
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

// One row per employee per pay period, created when payroll is actually run
model PayrollRun {
  id          String        @id @default(uuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  totalHours  Float?
  totalPieces Int           @default(0)
  daysPresent Int?
  grossPay    Float
  netPay      Float
  status      PayrollStatus @default(DRAFT)
  paidOn      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("payroll_runs")
}

enum PayrollStatus {
  DRAFT
  PAID
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Order {
  id             String      @id @default(uuid())
  shopId         String
  shop           Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title          String?
  clientName     String
  clientPhone    String
  instructions   String?
  deliveryDate   DateTime
  amount         Float
  advancePayment Float       @default(0)
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  assignments WorkAssignment[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
  CANCELLED
}

model WorkAssignment {
  id         String           @id @default(uuid())
  orderId    String
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task       String
  status     AssignmentStatus @default(PENDING)
  dueDate    DateTime?
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@map("work_assignments")
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model ActivityLog {
  id        String   @id @default(uuid())
  shopId    String
  type      String
  message   String
  actorName String?
  createdAt DateTime @default(now())

  @@index([shopId, createdAt])
  @@map("activity_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}
