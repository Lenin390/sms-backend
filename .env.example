# Copy this file to .env and fill in your real values. Never commit .env to git.
DATABASE_URL="postgresql://postgres:password@localhost:5432/bms_db"

# Generate a strong random string, e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="replace_this_with_a_long_random_string"
JWT_REFRESH_SECRET="replace_this_with_a_different_long_random_string"

JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

PORT=5000
NODE_ENV=development

CORS_ORIGIN="http://localhost:5173,*"
