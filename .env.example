DATABASE_URL="postgresql://postgres:password@localhost:5432/sms_db"

JWT_ACCESS_SECRET="replace_this_with_a_long_random_string"
JWT_REFRESH_SECRET="replace_this_with_a_different_long_random_string"
JWT_ACCESS_EXPIRY="15m"

# Used when the person does NOT check "Remember me" at login
JWT_REFRESH_EXPIRY_SESSION="1d"
# Used when they DO check "Remember me"
JWT_REFRESH_EXPIRY_REMEMBER="30d"
# Fallback used by /auth/refresh's token rotation - keep as-is unless you have a reason to change it
JWT_REFRESH_EXPIRY="7d"

PORT=5000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

FRONTEND_URL="http://localhost:5173"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="SMS <onboarding@resend.dev>"
